            ".validate": false
          }
        }
      }
    },
    "roleAssignments": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && root.child('chats').child($chatId).child('creatorId').val() === auth.uid && root.child('chatMembers').child($chatId).child(auth.uid).val() === 'owner' && $uid !== root.child('chats').child($chatId).child('creatorId').val()",
          ".validate": "!newData.exists() || (newData.isString() && root.child('chatRoles').child($chatId).child(newData.val()).exists())"
        }
      }
    },
    "pollVotes": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        "$messageId": {
          "$chatId": {
            ".write": "auth != null && auth.uid === $uid && root.child('chatMembers').child($chatId).child(auth.uid).exists() && root.child('messages').child($chatId).child($messageId).child('type').val() === 'poll' && (!newData.exists() || root.child('messages').child($chatId).child($messageId).child('poll').child('options').child(newData.val()).exists())",
            ".validate": "newData.isString() && newData.val().length <= 100"
          }
        }
      }
    }
  }
}
